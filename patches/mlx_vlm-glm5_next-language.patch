+    def _sparse_prefill_attention(self, q, kv_latent, sel, valid):
+        """Attend each prefill query only to its indexer-selected keys.
+
+        q: [B, H, L, D] queries already in the latent space (absorbed form);
+        kv_latent: [B, 1, Kv, D]; sel: [B, L, W] clipped key positions;
+        valid: [B, L, W] which of those positions are real.
+
+        The dense-masked form scores every query against every key and then
+        discards all but W of them: O(L*Kv) per chunk, O(T^2) over a prompt,
+        and by 200k tokens three quarters of the read time. This gathers the W
+        selected rows per query and runs attention with the heads as the query
+        rows (one KV head, so the per-row softmax is unchanged): O(L*W) per
+        chunk, independent of context length. Each sub-chunk of C queries
+        gathers C*W*D*2 bytes (~0.5 GB at C=256) and is evaluated eagerly so
+        that only one gather is live at a time; left lazy, all of a chunk's
+        sub-chunks would be resident together (~2.4 GB at L=1024).
+        Assumes an unquantized KVCache and no duplicate positions within a
+        selection row (the indexer emits distinct pooled positions plus the
+        tail); a duplicate would be double-weighted here where the dense mask
+        was idempotent.
+        """
+        B, H, L, D = q.shape
+        W = sel.shape[-1]
+        kv2 = kv_latent[:, 0]  # [B, Kv, D]
+        outs = []
+        C = _SPARSE_PREFILL_CHUNK
+        for c0 in range(0, L, C):
+            c1 = min(L, c0 + C)
+            cs = c1 - c0
+            flat = sel[:, c0:c1].reshape(B, cs * W, 1)
+            g = mx.take_along_axis(
+                kv2, mx.broadcast_to(flat, (B, cs * W, D)), axis=1
+            ).reshape(B * cs, 1, W, D)
+            qc = q[:, :, c0:c1].transpose(0, 2, 1, 3).reshape(B * cs, 1, H, D)
+            mk = valid[:, c0:c1].reshape(B * cs, 1, 1, W)
+            o = mx.fast.scaled_dot_product_attention(qc, g, g, scale=self.scale, mask=mk)
+            o = o.reshape(B, cs, H, D).transpose(0, 2, 1, 3)
+            mx.eval(o)  # bound the live set to one sub-chunk's gather
+            outs.append(o)
+        return outs[0] if len(outs) == 1 else mx.concatenate(outs, axis=2)
+
